{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bingo Digital",
  "version": "../package.json",
  "identifier": "digital.bingo.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Bingo Digital",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https: http:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Bingo Digital",
    "category": "Utility",
    "shortDescription": "Sorteio de bingo para festas",
    "longDescription": "Bingo Digital: sorteio, conferência de cartelas e telão para festas e eventos. Funciona offline.",
    "copyright": "© 2026 Bingo Digital",
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "10.15"
    },
    "linux": {
      "deb": {
        "depends": []
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc4M0UwNDA3OEMzRDM2QkEKUldTNk5qMk1Cd1ErZVBsemtGRGduL2pFQVlZZmdJRE1iZnQ5TEdadjZ5UHBPdFd4Qk5KOURZQUUK",
      "endpoints": [],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}